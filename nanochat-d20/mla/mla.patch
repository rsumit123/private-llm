+        q = norm(q) * 1.2
+        c = norm(self.w_dkv(x))                                  # (B, T, dc)   <- cached
+        kr = self._rope(self.w_kr(x).view(B, T, 1, self.dr), cos_sin)  # (B, T, 1, dr) <- cached
