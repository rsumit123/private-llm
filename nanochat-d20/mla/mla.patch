index 0000000..f9d831a
--- /dev/null
+++ b/tests/test_mla.py
@@ -0,0 +1,71 @@
+"""MHA / GQA / MLA: full-sequence forward must equal incremental KV-cache decoding, and training must step.
+
+    python -m pytest tests/test_mla.py -q      (CPU, fp32)
+"""
+import pytest
+import torch
+
+from nanochat.engine import KVCache
+from nanochat.gpt import GPT, GPTConfig
+
+VARIANTS = {
+    "mha": dict(n_kv_head=4),
+    "gqa": dict(n_kv_head=2),
+    "mla": dict(n_kv_head=4, attn_type="mla", mla_kv_dim=48, mla_rope_dim=8),
+}
+
+
+def tiny(variant, use_ve=False):
+    cfg = GPTConfig(sequence_len=512, vocab_size=512, n_layer=4, n_head=4, n_embd=128, window_pattern="SSSL",
+                    use_value_embeds=use_ve, **VARIANTS[variant])
+    torch.manual_seed(0)
+    m = GPT(cfg)
+    m.init_weights()
+    with torch.no_grad():  # c_proj starts at zero; perturb so attention actually affects the logits
+        for p in m.parameters():
+            p.add_(torch.randn_like(p) * 0.02)
+    return m.eval()
+
+
+def cache_for(m, T):
+    c = m.config
+    return KVCache(batch_size=1, num_heads=c.n_kv_head, seq_len=T, head_dim=c.n_embd // c.n_head, num_layers=c.n_layer,
+                   device="cpu", dtype=torch.float32,
+                   latent_dim=(c.mla_kv_dim + c.mla_rope_dim) if c.attn_type == "mla" else 0)
+
+
+@pytest.mark.parametrize("variant", list(VARIANTS))
+def test_incremental_decode_matches_full_forward(variant):
+    m = tiny(variant)
+    torch.manual_seed(1)
+    ids = torch.randint(0, 512, (1, 300))  # > short window (128) so sliding-window masking is exercised
+    with torch.no_grad():
+        full = m(ids)
+        cache = cache_for(m, 300)
+        out = [m(ids[:, :200], kv_cache=cache)]
+        for t in range(200, 300):
+            out.append(m(ids[:, t:t + 1], kv_cache=cache))
+    inc = torch.cat(out, dim=1)
+    assert torch.allclose(full, inc, atol=2e-4, rtol=1e-4), (full - inc).abs().max()
+
+
+@pytest.mark.parametrize("variant", list(VARIANTS))
+def test_training_step_reduces_loss(variant):
+    m = tiny(variant).train()
+    opt = m.setup_optimizer()
+    torch.manual_seed(2)
+    x = torch.randint(0, 512, (4, 64))
+    y = torch.roll(x, -1, 1)
+    first = None
+    for _ in range(8):
+        loss = m(x, targets=y)
+        loss.backward()
+        opt.step()
+        m.zero_grad(set_to_none=True)
+        first = first if first is not None else loss.item()
+    assert loss.item() < first
+
+
+def test_mla_cache_is_smaller():
+    caches = {v: cache_for(tiny(v), 256).nbytes() for v in VARIANTS}
+    assert caches["gqa"] < caches["mha"] and caches["mla"] < caches["mha"]
