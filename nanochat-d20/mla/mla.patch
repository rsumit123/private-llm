+class MLAttention(nn.Module):
+    """Multi-head latent attention (DeepSeek-V2 style), adapted to nanochat.
+
+    Keys/values are reconstructed from a shared low-rank latent c = RMSNorm(W_dkv x); position goes through a separate
+    RoPE key k_r = RoPE(W_kr x) shared by all heads. Only [c, k_r] (mla_kv_dim + mla_rope_dim values per token per layer)
+    is cached, vs 2 * n_kv_head * head_dim for MHA/GQA. nanochat applies QK-norm to full keys, which blocks the usual
+    weight-absorption trick, so at inference the cached latents are re-expanded to keys/values each step: the KV cache is
+    small, at the cost of extra compute. No value embeddings (they bypass the KV path).
+    """
+    def __init__(self, config, layer_idx):
+        super().__init__()
+        self.layer_idx = layer_idx
+        self.n_head = config.n_head
+        self.head_dim = config.n_embd // config.n_head
+        self.dc, self.dr = config.mla_kv_dim, config.mla_rope_dim
+        self.dn = self.head_dim - self.dr  # non-positional part of each query/key head
+        assert self.dc > 0 and 0 < self.dr < self.head_dim and self.head_dim % self.dr == 0 and self.dr % 2 == 0
+        assert not config.use_value_embeds, "MLA variant runs without value embeddings"
+        self.rope_stride = self.head_dim // self.dr  # take every k-th frequency: exactly RoPE frequencies for dim dr
+        self.c_q = Linear(config.n_embd, self.n_head * self.head_dim, bias=False)
+        self.w_dkv = Linear(config.n_embd, self.dc, bias=False)
+        self.w_kr = Linear(config.n_embd, self.dr, bias=False)
+        self.w_uk = Linear(self.dc, self.n_head * self.dn, bias=False)
+        self.w_uv = Linear(self.dc, self.n_head * self.head_dim, bias=False)
+        self.c_proj = Linear(config.n_embd, config.n_embd, bias=False)
+        self.ve_gate = None
+
+    def _rope(self, x, cos_sin):
+        cos, sin = cos_sin
+        return apply_rotary_emb(x, cos[..., ::self.rope_stride], sin[..., ::self.rope_stride])
+
+    def _expand(self, c, kr):
+        """latent (B,S,dc) + roped key (B,S,1,dr) -> keys and values (B,S,H,head_dim)"""
+        B, S, _ = c.shape
