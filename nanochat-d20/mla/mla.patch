new file mode 100644
index 0000000..09a45e2
--- /dev/null
+++ b/scripts/bench_attn.py
@@ -0,0 +1,71 @@
+"""Inference-side comparison of attention variants: KV-cache size and decode throughput.
+
+    python -m scripts.bench_attn --tags a_mha,a_gqa,a_mla --prompt 1024 --new 128 --batches 1,32
+Prints one JSON line per model tag.
+"""
+import argparse
+import json
+import time
+
+import torch
+
+from nanochat.checkpoint_manager import load_model
+from nanochat.common import autodetect_device_type, compute_init
+from nanochat.engine import KVCache
+
+
+def make_cache(cfg, batch, seq_len, device, dtype):
+    return KVCache(batch_size=batch, num_heads=cfg.n_kv_head, seq_len=seq_len, head_dim=cfg.n_embd // cfg.n_head,
+                   num_layers=cfg.n_layer, device=device, dtype=dtype,
+                   latent_dim=(cfg.mla_kv_dim + cfg.mla_rope_dim) if cfg.attn_type == "mla" else 0)
+
+
+@torch.inference_mode()
+def decode_tok_s(model, cfg, batch, prompt, new, device, dtype):
+    cache = make_cache(cfg, batch, prompt + new, device, dtype)
+    ids = torch.randint(0, cfg.vocab_size, (batch, prompt), device=device)
+    model(ids, kv_cache=cache)
+    nxt = torch.randint(0, cfg.vocab_size, (batch, 1), device=device)
+    for _ in range(3):  # warm up kernels without counting
+        model(nxt, kv_cache=cache)
+    if device.type == "cuda":
+        torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(new - 3):
+        model(nxt, kv_cache=cache)
+    if device.type == "cuda":
+        torch.cuda.synchronize()
+    return batch * (new - 3) / (time.perf_counter() - t)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tags", required=True)
+    ap.add_argument("--prompt", type=int, default=1024)
+    ap.add_argument("--new", type=int, default=128)
+    ap.add_argument("--batches", default="1,32")
+    ap.add_argument("--budget-gb", type=float, default=10.0)
+    ap.add_argument("--device-type", default="")
+    args = ap.parse_args()
+    _, _, _, _, device = compute_init(args.device_type or autodetect_device_type())
+    for tag in args.tags.split(","):
+        model, _, meta = load_model("base", device, phase="eval", model_tag=tag)
+        cfg = model.config
+        dtype = model.cos.dtype
+        seq = cfg.sequence_len
+        per_seq = make_cache(cfg, 1, seq, "meta", dtype).nbytes()
+        row = {"tag": tag, "attn_type": cfg.attn_type, "n_kv_head": cfg.n_kv_head, "mla_kv_dim": cfg.mla_kv_dim,
+               "params_M": round(sum(p.numel() for p in model.parameters()) / 1e6, 2),
+               "kv_bytes_per_token": per_seq // seq,
+               "kv_MB_per_seq": round(per_seq / 2**20, 2),
+               "seqs_in_budget": int(args.budget_gb * 2**30 // per_seq)}
+        for b in map(int, args.batches.split(",")):
+            row[f"decode_tok_s_b{b}"] = round(decode_tok_s(model, cfg, b, args.prompt, args.new, device, dtype), 1)
+        print(json.dumps(row), flush=True)
+        del model
+        if device.type == "cuda":
+            torch.cuda.empty_cache()
+
+
+if __name__ == "__main__":
+    main()
